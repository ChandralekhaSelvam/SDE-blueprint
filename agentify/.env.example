# ---------------------------------------------------------------- run mode
# demo  no network calls at all. The deterministic scorer produces a complete,
#       DoD-satisfying blueprint. Use this for offline demos and CI.
# live  the same pipeline, plus model adjudication where the deterministic
#       result is genuinely uncertain.
RUN_MODE=demo

# ---------------------------------------------------------------- provider
# mock | anthropic | vertex | genengine
LLM_PROVIDER=mock

# --- Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_SMALL=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_MEDIUM=claude-sonnet-5
ANTHROPIC_MODEL_LARGE=claude-opus-5

# --- Google Cloud Vertex AI
# Locally: gcloud auth application-default login
# On Cloud Run or GKE: attach a service account with roles/aiplatform.user
GCP_PROJECT=
GCP_LOCATION=us-central1
VERTEX_MODEL_SMALL=gemini-2.5-flash-lite
VERTEX_MODEL_MEDIUM=gemini-2.5-flash
VERTEX_MODEL_LARGE=gemini-2.5-pro

# ---  Generative Engine (OpenAI-compatible surface)
GENENGINE_BASE_URL=
GENENGINE_API_KEY=
GENENGINE_MODEL_SMALL=gpt-4o-mini
GENENGINE_MODEL_MEDIUM=gpt-4o
GENENGINE_MODEL_LARGE=claude-sonnet-4

# ------------------------------------------------------- cost and behaviour
# Scores inside this window reach a model. Everything else is arithmetic.
AMBIGUOUS_LOW=55
AMBIGUOUS_HIGH=80
CONFIDENCE_FLOOR=0.85

# Hard ceilings. The router degrades to deterministic rather than overspend.
MAX_LLM_CALLS=60
BUDGET_USD=2.00

ENABLE_CACHE=true
DATA_DIR=./data
POLICY_DIR=./policy
CORS_ORIGINS=*
